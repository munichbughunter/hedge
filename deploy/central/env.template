# Einstellungen für docker-compose.yml.

# Die Images gehören zur Hedge-Version, mit der dieses Verzeichnis
# geschrieben wurde. Für eine eigene Registry: hier den gespiegelten Namen
# eintragen.
HEDGE_IMAGE=ghcr.io/munichbughunter/hedge:{{VERSION}}
PRESIDIO_IMAGE=ghcr.io/munichbughunter/hedge-presidio:{{VERSION}}

# Wo Hedge auf dem Host lauscht. 127.0.0.1 = nur über den Reverse Proxy auf
# demselben Host. 0.0.0.0 nur, wenn TLS woanders terminiert wird.
HEDGE_BIND=127.0.0.1
HEDGE_PORT=18765

# Die Steuer-API (hedge status, Freigaben, hedge watch) hat ihren eigenen
# Port. Nur für Admins; von außen über Caddy oder deinen Reverse Proxy.
HEDGE_CONTROL_BIND=127.0.0.1
HEDGE_CONTROL_PORT=18766

# TLS mit Caddy (Profil "tls"). HEDGE_DOMAIN ist der Name, den Entwickler
# und Admins benutzen; er muss auf diesen Host zeigen.
HEDGE_DOMAIN=hedge.example.com
# Woher das Zertifikat kommt – eines von:
#   internal                                  Caddys eigene CA (Entwickler müssen ihrer Wurzel vertrauen, README)
#   /certs/fullchain.pem /certs/privkey.pem   dein Zertifikat, abgelegt in ./certs
#   admin@example.com                         Let's Encrypt (der Name muss aus dem Internet erreichbar sein)
HEDGE_TLS=internal
# Netze, die die Steuer-API (/_hedge/*) über Caddy erreichen dürfen, durch
# Leerzeichen getrennt, z. B. 10.0.10.0/24 192.168.1.20/32. Alle anderen
# bekommen 404. Der Standard lässt von außen niemanden hinein.
HEDGE_ADMIN_CIDRS=127.0.0.1/32
HEDGE_HTTPS_PORT=443

# Presidio: Prozesse, die parallel analysieren. Jeder braucht rund 0,7 GB
# Arbeitsspeicher und einen CPU-Kern.
PRESIDIO_WORKERS=2

# Was dazukommt: tls = Caddy davor, observability = Grafana mit Dashboard
# und Alerts. Mehrere mit Komma.
{{PROFILES}}
GRAFANA_PORT=3000
