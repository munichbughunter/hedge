      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, direction) (increase(hedge_findings_total[$__rate_interval]))",
          "legendFormat": "{{kind}} ({{direction}})"
