      },
      "description": "analyzed = sent to Presidio, cached = answered from Hedge's cache, failed = Presidio gave an error."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Presidio: duration of one analysis",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
