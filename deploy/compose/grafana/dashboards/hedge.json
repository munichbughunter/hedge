        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "forwarded = went to the model unchecked (on_unavailable = allow). blocked = rejected by Hedge (on_unavailable = block)."
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Presidio: texts by result",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
